# Copier en .env et renseigner les valeurs.

# Jeton partagé avec Django (même valeur que IA_SERVICE_TOKEN côté backend).
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
SERVICE_TOKEN=

# LLM (clé : Google AI Studio)
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_DELAI_S=60

# Limites (valeurs par défaut dans app/config.py)
TAILLE_MAX_MO=10
NB_FICHIERS_MAX=5
MAX_CHARS=30000
NB_QUESTIONS_MAX=20
MAX_ESSAIS=3
NB_PAGES_MAX=100
TAILLE_DECOMPRESSEE_MAX_MO=100
EXTRACTION_DELAI_S=30
